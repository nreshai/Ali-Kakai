echo "  ███████╗██████╔╝█████╗  ██║        ██║   █████╗  ██████╔╝"
echo "  ╚════██║██╔═══╝ ██╔══╝  ██║        ██║   ██╔══╝  ██╔══██╗"
echo "  ███████║██║     ███████╗╚██████╗   ██║   ███████╗██║  ██║"
