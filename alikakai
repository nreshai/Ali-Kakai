# Resolve Project Root Directory
locate_project_dir() {
  # 1. Check current directory
  if [ -f "./package.json" ] && [ -f "./vite.config.ts" ]; then
    pwd
    return
  fi

  # 2. Check script directory
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
  if [ -f "${script_dir}/package.json" ]; then
    echo "$script_dir"
    return
  fi

  # 3. Check ~/.specteros_dir pointer
  if [ -f "${HOME}/.specteros_dir" ]; then
    local saved_dir
    saved_dir="$(cat "${HOME}/.specteros_dir" 2>/dev/null)"
    if [ -n "$saved_dir" ] && [ -f "${saved_dir}/package.json" ]; then
      echo "$saved_dir"
      return
    fi
  fi

  # 4. Standard Termux home locations
  for candidate in "${HOME}/specteros" "${HOME}/SpecterOS" "${HOME}/specteros-v7.4" "${HOME}/applet"; do
    if [ -f "${candidate}/package.json" ]; then
      echo "$candidate"
      return
    fi
  done

  pwd
}

PROJECT_DIR="$(locate_project_dir)"
