# Clean exit handler
cleanup() {
  echo ""
  echo -e "${YELLOW}[*] Shutting down SpecterOS engine gracefully...${NC}"
  stop_existing_server
  log_msg "INFO" "SpecterOS server stopped by user signal"
  exit 0
}
trap cleanup SIGINT SIGTERM

MAX_RETRIES=2
ATTEMPT=1

while [ $ATTEMPT -le $MAX_RETRIES ]; do
  if [ "$DEBUG_MODE" = "true" ]; then
    npm run dev -- --host 0.0.0.0 --port "$SELECTED_PORT" 2>&1 | tee -a "$LOG_FILE" &
  else
    npm run dev -- --host 0.0.0.0 --port "$SELECTED_PORT" >> "$LOG_FILE" 2>&1 &
  fi
  SERVER_PID=$!
  echo "$SERVER_PID" > "$PID_FILE"

  # Wait 2.5 seconds to monitor initial boot health
  sleep 2.5

  if kill -0 "$SERVER_PID" 2>/dev/null; then
    # Server is healthy and running in foreground wait
    wait "$SERVER_PID"
    break
  else
    echo -e "${RED}[!] Server exited unexpectedly on attempt $ATTEMPT of $MAX_RETRIES. Checking logs...${NC}"
    log_msg "WARN" "Server process $SERVER_PID crashed on attempt $ATTEMPT"
    tail -n 12 "$LOG_FILE" 2>/dev/null
    ATTEMPT=$((ATTEMPT + 1))
    if [ $ATTEMPT -le $MAX_RETRIES ]; then
      echo -e "${YELLOW}[*] Retrying after cache purge...${NC}"
      rm -rf .cache node_modules/.vite 2>/dev/null || true
      sleep 1
    fi
  fi
done

cleanup
