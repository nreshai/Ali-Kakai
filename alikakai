    echo "  --info       Display system architecture, Node, and Termux telemetry"
    echo "  --clean      Remove cache, dist build outputs, and temporary logs"
    echo "  --reinstall  Wipe node_modules and perform clean dependency installation"
    echo "  --build      Compile optimized production build artifacts"
    echo "  --prod       Launch production preview server"
    echo "  --help       Show this help documentation"
    exit 0
    ;;
esac

